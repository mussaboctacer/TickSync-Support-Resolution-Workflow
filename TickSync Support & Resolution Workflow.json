        "jsCode": "// HMAC Secret key\nconst secret = 'super-secret-key-2025';\n\n// Webhook se data lo\nconst ticketId = $json.ticket_id;\nconst newStatus = $json.new_status;\nconst resolvedAt = $json.resolved_at;\nconst receivedSignature = $json.signature;\n\n// String banao jo signature ke liye use hoga\nconst message = `${ticketId}|${newStatus}|${resolvedAt}`;\n\n// HMAC_SHA256 calculate karo\nconst crypto = require('crypto');\nconst computedSignature = crypto\n  .createHmac('sha256', secret)\n  .update(message)\n  .digest('hex');\n\n// Compare karo\nconst isValid = computedSignature === receivedSignature;\n\n// Return result\nreturn {\n  isValid: isValid,\n  computedSignature: computedSignature,\n  receivedSignature: receivedSignature,\n  message: message\n};"
      },
